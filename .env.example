# Copie para .env e ajuste. Nunca versione o .env real.

# dev | prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Postgres (dev local - docker-compose up -d db)
DATABASE_URL=postgres://rb_prospecta:rb_prospecta@localhost:5432/rb_prospecta_dev

# Segredo do Django (gerar: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=troque-por-um-segredo-aleatorio

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Streamlit (analytics)
STREAMLIT_URL=http://localhost:8501
